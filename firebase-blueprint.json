{
  "entities": {
    "Book": {
      "collection": "books",
      "fields": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "authorName": { "type": "string", "maxLength": 128 },
        "categoryId": { "type": "string", "maxLength": 128 },
        "categoryName": { "type": "string", "maxLength": 128 },
        "subcategoryId": { "type": "string", "maxLength": 128, "optional": true },
        "subcategoryName": { "type": "string", "maxLength": 128, "optional": true },
        "coverUrl": { "type": "string", "maxLength": 1024 },
        "description": { "type": "string", "maxLength": 5000 },
        "pdfUrl": { "type": "string", "maxLength": 1024, "optional": true },
        "googleDriveUrl": { "type": "string", "maxLength": 1024, "optional": true },
        "pages": { "type": "number" },
        "publicationYear": { "type": "number" },
        "language": { "type": "string", "maxLength": 64 },
        "views": { "type": "number" },
        "downloads": { "type": "number" },
        "rating": { "type": "number" },
        "ratingCount": { "type": "number" },
        "isFeatured": { "type": "boolean", "optional": true },
        "isTrending": { "type": "boolean", "optional": true },
        "hasAudio": { "type": "boolean", "optional": true },
        "createdAt": { "type": "string", "maxLength": 64, "optional": true }
      }
    },
    "Category": {
      "collection": "categories",
      "fields": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "slug": { "type": "string", "maxLength": 128 },
        "iconName": { "type": "string", "maxLength": 64 },
        "color": { "type": "string", "maxLength": 64 },
        "description": { "type": "string", "maxLength": 1000 },
        "subcategories": { "type": "array", "optional": true }
      }
    },
    "Author": {
      "collection": "authors",
      "fields": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "bio": { "type": "string", "maxLength": 2000 },
        "avatarUrl": { "type": "string", "maxLength": 1024 },
        "booksCount": { "type": "number" }
      }
    },
    "UserProgress": {
      "collection": "user_progress",
      "fields": {
        "id": { "type": "string", "maxLength": 256 },
        "userId": { "type": "string", "maxLength": 128 },
        "bookId": { "type": "string", "maxLength": 128 },
        "currentPage": { "type": "number" },
        "totalPages": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      }
    }
  }
}
